# Copy this file to .env and fill in your key from Google AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Model used by all agents. If Google renames or retires it, put any current
# Gemini Flash model name from AI Studio here.
CARE_AGENT_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is busy (503) or out of free quota (429).
CARE_AGENT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# Optional: a stronger vision model just for the X-ray agent.
# CARE_AGENT_IMAGING_MODEL=<a stronger Gemini model name from AI Studio>

# Optional: Supabase / Postgres instead of local SQLite (needs: pip install asyncpg)
# SESSION_DB_URI=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
